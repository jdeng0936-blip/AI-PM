# ────────────────────────────────────────────────────────────────
# AI-PM 前端环境配置模板
# 复制本文件为 .env.local,填写真实值后使用
# ────────────────────────────────────────────────────────────────

# 后端 API base URL(开发期默认走 next.config.js rewrites,生产指向真实后端)
BACKEND_URL=http://localhost:8000

# ── Sentry 错误监控(Stage 1 配置预留) ───────────────────────────
# 留空则不启用,完全 no-op,不影响 build。
# 启用步骤详见 docs/SENTRY_SETUP.md。
#
# Public DSN — 会被打进客户端 bundle(可被访客读到,但 DSN 是 public 的)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=dev
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# 服务端 DSN(SSR / API routes / middleware 用),默认可与 public 共用同一 DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
# 生产环境上传 source map 用(只在 CI build 时需要,不要进客户端 bundle)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
