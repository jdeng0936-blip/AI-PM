# ════════════════════════════════════════════════════════════════
# 徽远成 AI-PM V2.1 生产环境配置模板
#
# 使用步骤:
#   1. 复制为 .env:           cp .env.production.template .env
#   2. 填入真实值(标 ⚠️ 的必改)
#   3. 跑预检:                bash scripts/preflight.sh
#   4. 跑迁移:                alembic upgrade head
#   5. 启动:                  docker compose -f docker-compose.prod.yml up -d
#   6. 配 crontab:
#        0 3 * * *  cd /opt/aipm/backend && bash scripts/backup.sh
#        0 4 * * 1  cd /opt/aipm/backend && bash scripts/restore_drill.sh
#
# 安全:.env 包含密钥,严禁提交到 Git。.gitignore + pre-commit hook 已双重保护。
#
# 详细操作步骤见:docs/PRODUCTION_DEPLOY.md
# ════════════════════════════════════════════════════════════════

# ─── 运行模式 ────────────────────────────────────────────────────
# prod = 禁用 /simulate dev 端点 + 强校验 + 关闭 SQL echo
AIPM_ENV=prod


# ─── 数据库(PostgreSQL 16 + pgvector)──────────────────────────
# 生产建议:用独立的强密码,避免与其它系统共用
POSTGRES_PASSWORD=⚠️_GENERATE_STRONG_PASSWORD_HERE
DATABASE_URL=postgresql+asyncpg://aipm:⚠️_SAME_AS_POSTGRES_PASSWORD@postgres:5432/aipm_db


# ─── Redis 缓存 + 分布式锁(V2.1 必需)──────────────────────────
# Stage 1 引入 services/distributed_lock 用 Redis SETNX 防多实例 cron 重复触发。
# Redis 不可用时降级为单实例语义,但生产强烈建议 Redis 可用。
REDIS_URL=redis://redis:6379/0


# ─── JWT 密钥 ──── ⚠️ 上线前必改! ─────────────────────────────
# 用以下命令生成 64 位强随机密钥:
#   openssl rand -hex 32
JWT_SECRET_KEY=⚠️_RUN_openssl_rand_hex_32_THEN_PASTE_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_EXPIRE_HOURS=24


# ─── LLM 网关(LiteLLM / NewAPI) ────────────────────────────────
LITELLM_BASE_URL=https://your-litellm-host/v1
LITELLM_API_KEY=⚠️_YOUR_LITELLM_KEY
# 兼容别名(代码两种都读):
NEW_API_BASE_URL=
NEW_API_KEY=

# 每日 Token 限流(防止 LLM 滥用,默认 50 万)
DAILY_TOKEN_LIMIT=500000


# ─── 企业微信(Week 1)───────────────────────────────────────────
# 自建应用(精准推送给个人,需 AppKey/AppSecret/AgentId)
WECHAT_CORP_ID=ww_your_corp_id
WECHAT_CORP_SECRET=⚠️_YOUR_APP_SECRET
WECHAT_AGENT_ID=1000001
WECHAT_TOKEN=⚠️_YOUR_CALLBACK_TOKEN
WECHAT_ENCODING_AES_KEY=⚠️_YOUR_43_CHAR_AES_KEY

# 群机器人 Webhook(群推战情日报/风险预警)
# 获取:企微群 > 群机器人 > 添加机器人 > 自定义 > 复制 Webhook
WECHAT_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY


# ─── 钉钉(Week 1)───────────────────────────────────────────────
# 群机器人 Webhook(推荐,免开发最快接入)
# 获取:钉钉群 > 群设置 > 智能群助手 > 添加机器人 > 自定义
DINGTALK_BOT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

# 加签 Secret(机器人安全设置选「加签」时填)
DINGTALK_BOT_SECRET=SECxxxxx

# 企业应用(可选,精准推送给个人)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=


# ─── OSS 对象存储(Week 3 附件 + 语音)───────────────────────────
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=huiyuancheng-aipm-prod
OSS_ACCESS_KEY_ID=⚠️_YOUR_OSS_KEY
OSS_ACCESS_KEY_SECRET=⚠️_YOUR_OSS_SECRET
OSS_PUBLIC_URL_BASE=

# 本地降级目录(OSS 未配置或异常时兜底,生产不建议依赖)
LOCAL_UPLOAD_DIR=/app/uploads


# ─── 讯飞 / Gemini ASR(Week 3 语音转文字)─────────────────────
# provider 可选:gemini(走 LiteLLM 网关) | xunfei(走讯飞流式 ASR) | none
ASR_PROVIDER=gemini

# 讯飞凭证(provider=xunfei 时必填)
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=


# ─── CORS(必改!) ─── ⚠️ ───────────────────────────────────────
# 生产前端域名,多个逗号分隔。不要用 *
# 例:CORS_ALLOWED_ORIGINS=["https://aipm.huiyuancheng.com"]
CORS_ALLOWED_ORIGINS=⚠️_PUT_YOUR_FRONTEND_DOMAIN


# ─── 可选:外部 ERP / 第三方 API ─────────────────────────────────
PRODUCT_DB_HOST=
PRODUCT_DB_PORT=
PRODUCT_DB_NAME=
PRODUCT_DB_USER=
PRODUCT_DB_PASSWORD=
TIANYANCHA_API_KEY=


# ─── Sentry 错误监控(V2.1 Stage 4 引入)──── ⚠️ 上线前配置 ──
# 1. 登录 sentry.io,创建一个 Python/FastAPI 项目 + 一个 React 项目
# 2. 把两个 DSN 分别填到下方
# 3. 重启 backend 后日志会输出 "🛰️ Sentry 已启用 env=prod"
SENTRY_DSN=⚠️_YOUR_BACKEND_SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=prod
# Frontend Sentry(NEXT_PUBLIC_ 会被打进客户端 bundle,DSN 是 public,无所谓)
NEXT_PUBLIC_SENTRY_DSN=⚠️_YOUR_FRONTEND_SENTRY_DSN
NEXT_PUBLIC_SENTRY_ENVIRONMENT=prod
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1


# ─── pgvector 向量维度(V2.1 Stage 1)─────────────────────────
# 默认 1536(与 OpenAI text-embedding-3-small 兼容)
# 切换 embedding 模型时同步改 + 跑新 alembic migration
EMBEDDING_DIM=1536


# ─── 备份脚本可选 OSS 上传(V2.1 Phase 2.0)──────────────────
# 配置后 scripts/backup.sh 会把每日 pg_dump 上传到 OSS,需要先装 ossutil
# 留空则只在本地 ./backups/ 保留 14 天
BACKUP_OSS_BUCKET=


# ════════════════════════════════════════════════════════════════
# V2.1 已注册的 11 个定时任务(无需配置,启动后自动生效,均带 Redis 分布式锁):
#   00:05 每日 - 请假/出差状态到期恢复
#   00:30 每日 - 健康度全量重算
#   02:00 每月1日 - 审计日志归档(>12 个月 → audit_logs_archive)
#   08:30 周一 - 资源水位刷新 + 过载预警
#   09:00 每日 - 晨报 AI 生成
#   09:00 周一 - 上周管理周报
#   09:30 每月1日 - OKR 季度归档 + AI 复盘
#   17:30 每日 - 催报-友好提醒
#   18:00 每日 - Sprint 燃尽快照
#   20:00 每日 - 催报-二次催促
#   22:00 每日 - 催报截止 + 通知总经理
# ════════════════════════════════════════════════════════════════
